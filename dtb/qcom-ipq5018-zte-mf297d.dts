            reg = <0xb00b040 0x0>;
            compatible = "qcom,qcn6122-wifi";
            interrupts-extended = <0x1 0x0 0x1c0 0x1 0x1 0x0 0x1c1 0x1 0x1 0x0 0x1c2 0x1 0x1 0x0 0x1c3 0x1 0x1 0x0 0x1c4 0x1 0x1 0x0 0x1c5 0x1 0x1 0x0 0x1c6 0x1 0x1 0x0 0x1c7 0x1 0x1 0x0 0x1c8 0x1 0x1 0x0 0x1c9 0x1 0x1 0x0 0x1ca 0x1 0x1 0x0 0x1cb 0x1 0x1 0x0 0x1cc 0x1 0x31 0x18 0x0 0x31 0x19 0x0 0x31 0x1c 0x0 0x31 0x1b 0x0>;
            interrupt-names = "ce1", "ce2", "ce3", "ce4", "ce5", "dp1", "dp2", "dp3", "dp4", "dp5", "dp6", "dp7", "dp8", "fatal", "ready", "spawn", "stop-ack";
            qcom,smem-states = <0x32 0x18 0x32 0x19 0x32 0x1a>;
            qcom,smem-state-names = "shutdown", "stop", "spawn";
            status = "disabled";
        };
    };
    thermal-zones {
        cpu-thermal {
            thermal-sensors = <0x3c 0x2>;
            trips {
                cpu-critical {
                    temperature = <0x1d4c0>;
                    hysteresis = <0x3e8>;
                    type = "critical";
                };
                cpu-passive {
                    temperature = <0x186a0>;
                    hysteresis = <0x3e8>;
                    type = "passive";
                    phandle = <0x3d>;
                };
            };
            cooling-maps {
                map0 {
                    trip = <0x3d>;
                    cooling-device = <0x3e 0xffffffff 0xffffffff 0x3f 0xffffffff 0xffffffff>;
                };
            };
        };
        gephy-thermal {
            thermal-sensors = <0x3c 0x4>;
            trips {
                gephy-critical {
                    temperature = <0x1d4c0>;
                    hysteresis = <0x3e8>;
                    type = "critical";
                };
            };
        };
        top-glue-thermal {
            thermal-sensors = <0x3c 0x3>;
            trips {
                top-glue-critical {
                    temperature = <0x1d4c0>;
                    hysteresis = <0x3e8>;
                    type = "critical";
                };
            };
        };
        ubi32-thermal {
            thermal-sensors = <0x3c 0x1>;
            trips {
                ubi32-critical {
                    temperature = <0x1d4c0>;
                    hysteresis = <0x3e8>;
                    type = "critical";
                };
            };
        };
    };
    timer {
        compatible = "arm,armv8-timer";
        interrupts = <0x1 0x2 0xf08 0x1 0x3 0xf08 0x1 0x4 0xf08 0x1 0x1 0xf08>;
    };
    smp2p-wcss {
        compatible = "qcom,smp2p";
        qcom,smem = <0x1b3 0x1ac>;
        interrupt-parent = <0x1>;
        interrupts = <0x0 0xb1 0x1>;
        mboxes = <0x5 0x9>;
        qcom,local-pid = <0x0>;
        qcom,remote-pid = <0x1>;
        master-kernel {
            qcom,entry-name = "master-kernel";
            qcom,smp2p-feature-ssr-ack;
            #qcom,smem-state-cells = <0x1>;
            phandle = <0x32>;
        };
        slave-kernel {
            qcom,entry-name = "slave-kernel";
            interrupt-controller;
            #interrupt-cells = <0x2>;
            phandle = <0x31>;
        };
    };
    aliases {
        ethernet1 = "/soc@0/ethernet@39d00000";
        label-mac-device = "/soc@0/ethernet@39d00000";
        serial0 = "/soc@0/serial@78af000";
        i2c0 = "/soc@0/i2c@78b7000";
    };
    chosen {
        bootargs-append = " ubi.mtd=ubi_data root=/dev/ubiblock0_1 swiotlb=1 coherent_pool=2M panic=5";
        stdout-path = "serial0:115200n8";
    };
    keys {
        compatible = "gpio-keys";
        pinctrl-0 = <0x40>;
        pinctrl-names = "default";
        button-reset {
            label = "reset";
            gpios = <0x21 0x20 0x1>;
            linux,code = <0x198>;
            debounce-interval = <0x3c>;
        };
        button-wps {
            label = "wps";
            gpios = <0x21 0x26 0x1>;
            linux,code = <0x211>;
            debounce-interval = <0x3c>;
        };
    };
    leds {
        compatible = "gpio-leds";
        pinctrl-0 = <0x41>;
        pinctrl-names = "default";
        led-modem-reset {
            label = "ctl:modem-reset";
            gpios = <0x21 0x1a 0x0>;
            default-state = "off";
        };
        led-board-power {
            label = "ctl:board-power";
            gpios = <0x21 0x23 0x1>;
            default-state = "on";
        };
    };
    regulator-usb-vbus {
        compatible = "regulator-fixed";
        regulator-name = "usb_vbus";
        regulator-min-microvolt = <0x4c4b40>;
        regulator-max-microvolt = <0x4c4b40>;
        gpio = <0x21 0x18 0x1>;
        regulator-boot-on;
        regulator-always-on;
        phandle = <0xa>;
    };
};
