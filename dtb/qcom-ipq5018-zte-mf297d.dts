/dts-v1/;

/ {
    interrupt-parent = <0x1>;
    #address-cells = <0x2>;
    #size-cells = <0x2>;
    model = "ZTE MF297D";
    compatible = "zte,mf297d", "qcom,ipq5018";
    clocks {
        gephy-rx-clk {
            compatible = "fixed-clock";
            clock-frequency = <0x7735940>;
            #clock-cells = <0x0>;
            phandle = <0x27>;
        };
        gephy-tx-clk {
            compatible = "fixed-clock";
            clock-frequency = <0x7735940>;
            #clock-cells = <0x0>;
            phandle = <0x28>;
        };
        ref-96mhz-clk {
            compatible = "fixed-factor-clock";
            clocks = <0x2>;
            #clock-cells = <0x0>;
            clock-div = <0x1>;
            clock-mult = <0x2>;
            phandle = <0x3>;
        };
        sleep-clk {
            compatible = "fixed-clock";
            #clock-cells = <0x0>;
            clock-frequency = <0x7d00>;
            phandle = <0x23>;
        };
        xo-board-clk {
            compatible = "fixed-factor-clock";
            clocks = <0x3>;
            #clock-cells = <0x0>;
            clock-div = <0x4>;
            clock-mult = <0x1>;
            phandle = <0x22>;
        };
        xo-clk {
            compatible = "fixed-clock";
            #clock-cells = <0x0>;
            clock-frequency = <0x2dc6c00>;
            phandle = <0x2>;
        };
    };
    cpus {
        #address-cells = <0x1>;
        #size-cells = <0x0>;
        cpu@0 {
            device_type = "cpu";
            compatible = "arm,cortex-a53";
            reg = <0x0>;
            enable-method = "psci";
            next-level-cache = <0x4>;
            clocks = <0x5 0x1>;
            operating-points-v2 = <0x6>;
            #cooling-cells = <0x2>;
            phandle = <0x3e>;
        };
        cpu@1 {
            device_type = "cpu";
            compatible = "arm,cortex-a53";
            reg = <0x1>;
            enable-method = "psci";
            next-level-cache = <0x4>;
            clocks = <0x5 0x1>;
            operating-points-v2 = <0x6>;
            #cooling-cells = <0x2>;
            phandle = <0x3f>;
        };
        l2-cache {
            compatible = "cache";
            cache-level = <0x2>;
            cache-size = <0x80000>;
            cache-unified;
            phandle = <0x4>;
        };
    };
    opp-table-cpu {
        compatible = "operating-points-v2";
        opp-shared;
        phandle = <0x6>;
        opp-1008000000 {
            opp-hz = <0x0 0x3c14dc00>;
            opp-microvolt = <0x10c8e0>;
            clock-latency-ns = <0x30d40>;
        };
        opp-1296000000 {
            opp-hz = <0x0 0x4d3f6400>;
            opp-microvolt = <0x10c8e0>;
            clock-latency-ns = <0x30d40>;
        };
    };
    firmware {
        scm {
            compatible = "qcom,scm-ipq5018", "qcom,scm";
            qcom,dload-mode = <0x7 0x6100>;
            qcom,sdi-enabled;
        };
    };
    memory@40000000 {
        device_type = "memory";
        reg = <0x0 0x40000000 0x0 0x20000000>;
    };
    pmu {
        compatible = "arm,cortex-a53-pmu";
        interrupts = <0x1 0x7 0xf04>;
    };
    psci {
        compatible = "arm,psci-1.0";
        method = "smc";
    };
    reserved-memory {
        #address-cells = <0x2>;
        #size-cells = <0x2>;
        ranges;
        memory@40000000 {
            reg = <0x0 0x40000000 0x0 0x1000000>;
            no-map;
            phandle = <0x39>;
        };
        tz_apps@4a400000 {
            reg = <0x0 0x4a400000 0x0 0x400000>;
            no-map;
        };
        bootloader@4a800000 {
            reg = <0x0 0x4a800000 0x0 0x200000>;
            no-map;
        };
        sbl@4aa00000 {
            reg = <0x0 0x4aa00000 0x0 0x100000>;
            no-map;
        };
        smem@4ab00000 {
            compatible = "qcom,smem";
            reg = <0x0 0x4ab00000 0x0 0x100000>;
            no-map;
            hwlocks = <0x8 0x3>;
        };
        tz@4ac00000 {
            reg = <0x0 0x4ac00000 0x0 0x400000>;
            no-map;
        };
        wcss@4b000000 {
            reg = <0x0 0x4b000000 0x0 0x1400000>;
            no-map;
            phandle = <0x36>;
        };
        q6-region-ipq5018@4c400000 {
            reg = <0x0 0x4c400000 0x0 0xd00000>;
            no-map;
            phandle = <0x33>;
        };
        m3-dump-ipq5018@4d100000 {
            reg = <0x0 0x4d100000 0x0 0x100000>;
            no-map;
            phandle = <0x34>;
        };
        q6-region-qcn6122-1@4d200000 {
            reg = <0x0 0x4d200000 0x0 0xd00000>;
            no-map;
            phandle = <0x3a>;
        };
        m3-dump-qcn6122-1@4df00000 {
            reg = <0x0 0x4df00000 0x0 0x100000>;
            no-map;
            phandle = <0x3b>;
        };
        q6-etr@4e000000 {
            reg = <0x0 0x4e000000 0x0 0x500000>;
            no-map;
        };
    };
    soc@0 {
        compatible = "simple-bus";
        #address-cells = <0x1>;
        #size-cells = <0x1>;
        ranges = <0x0 0x0 0x0 0xffffffff>;
        phy@5b000 {
            compatible = "qcom,ipq5018-usb-hsphy";
            reg = <0x5b000 0x120>;
            clocks = <0x9 0x77>;
            resets = <0x9 0x4f>;
            #phy-cells = <0x0>;
            status = "okay";
            vdd-supply = <0xa>;
            phandle = <0x2f>;
        };
        phy@5d000 {
            compatible = "qcom,ipq5018-uniphy-usb3-phy";
            reg = <0x5d000 0x800>;
            clocks = <0x9 0x77 0x9 0xa9>;
            resets = <0x9 0x63>;
            #clock-cells = <0x0>;
            #phy-cells = <0x0>;
            qcom,phy-usb-mux-sel = <0x7 0x10540>;
            status = "okay";
            vdd-supply = <0xa>;
            phandle = <0x26>;
        };
        phy@7e000 {
            compatible = "qcom,ipq5018-uniphy-pcie-phy";
            reg = <0x7e000 0x800>;
            clocks = <0x9 0x42>;
            resets = <0x9 0x2f 0x9 0x30>;
            #clock-cells = <0x0>;
            #phy-cells = <0x0>;
            num-lanes = <0x1>;
            status = "disabled";
            phandle = <0x25>;
        };
        phy@86000 {
            compatible = "qcom,ipq5018-uniphy-pcie-phy";
            reg = <0x86000 0x1000>;
            clocks = <0x9 0x3c>;
            resets = <0x9 0x23 0x9 0x24>;
            #clock-cells = <0x0>;
            #phy-cells = <0x0>;
            num-lanes = <0x2>;
            status = "disabled";
            phandle = <0x24>;
        };
        mdio@88000 {
            compatible = "qcom,ipq5018-mdio", "qcom,ipq40xx-mdio";
            reg = <0x88000 0x64 0x19475c4 0x4>;
            #address-cells = <0x1>;
            #size-cells = <0x0>;
            clocks = <0x9 0x35>;
            clock-names = "gcc_mdio_ahb_clk";
            status = "okay";
            ethernet-phy@7 {
                compatible = "ethernet-phy-id004d.d0c0";
                reg = <0x7>;
                clocks = <0x9 0x24 0x9 0x25>;
                clock-names = "rx", "tx";
                resets = <0x9 0x6f>;
                phandle = <0x38>;
            };
        };
        mdio@90000 {
            compatible = "qcom,ipq5018-mdio";
            reg = <0x90000 0x64>;
            #address-cells = <0x1>;
            #size-cells = <0x0>;
            clocks = <0x9 0x36>;
            clock-names = "gcc_mdio_ahb_clk";
            status = "okay";
            pinctrl-0 = <0xb>;
            pinctrl-names = "default";
            ethernet-phy@0 {
                reg = <0x0>;
            };
            ethernet-phy@1 {
                reg = <0x1>;
                phandle = <0xc>;
            };
            ethernet-phy@2 {
                reg = <0x2>;
                phandle = <0xd>;
            };
            ethernet-phy@3 {
                reg = <0x3>;
                phandle = <0xe>;
            };
            ethernet-phy@4 {
                reg = <0x4>;
                phandle = <0xf>;
            };
            ethernet-switch@17 {
                compatible = "qca,qca8337";
                reg = <0x11>;
                #address-cells = <0x1>;
                #size-cells = <0x0>;
                ethernet-ports {
                    #address-cells = <0x1>;
                    #size-cells = <0x0>;
                    ethernet-port@2 {
                        reg = <0x2>;
                        label = "lan3";
                        phy-handle = <0xc>;
                    };
                    ethernet-port@3 {
                        reg = <0x3>;
                        label = "lan2";
                        phy-handle = <0xd>;
                    };
                    ethernet-port@4 {
                        reg = <0x4>;
                        label = "lan1";
                        phy-handle = <0xe>;
                    };
                    ethernet-port@5 {
                        reg = <0x5>;
                        label = "lan4";
                        phy-handle = <0xf>;
                    };
                    ethernet-port@6 {
                        reg = <0x6>;
                        label = "cpu";
                        phy-mode = "sgmii";
                        ethernet = <0x10>;
                        qca,sgmii-enable-pll;
                        fixed-link {
                            speed = <0x3e8>;
                            full-duplex;
                        };
                    };
                };
            };
        };
        ethernet-pcs@98000 {
            compatible = "qualcomm,ipq5018-uniphy";
            reg = <0x98000 0x800>;
            #clock-cells = <0x1>;
            clocks = <0x9 0x6e 0x9 0x70 0x9 0x6f 0x9 0x71 0x11 0x3>;
            clock-names = "ahb", "sys", "port5_rx", "port5_tx", "ref";
            clock-output-names = "uniphy0_gcc_rx_clk", "uniphy0_gcc_tx_clk", "uniphy0_ref_clk";
            resets = <0x9 0x6e>;
            reset-names = "soft";
            #pcs-cells = <0x0>;
            status = "okay";
            assigned-clocks = <0x12 0x2>;
            assigned-clock-rates = <0x17d7840>;
            phandle = <0x12>;
        };
        clock-controller@9b000 {
            compatible = "qcom,ipq5018-cmn-pll";
            reg = <0x9b000 0x800>;
            clocks = <0x3 0x9 0x1d 0x9 0x1e>;
            clock-names = "ref", "ahb", "sys";
            #clock-cells = <0x1>;
            assigned-clocks = <0x11 0x0>;
            assigned-clock-rates-u64 = <0x1 0x1e1a3000>;
            phandle = <0x11>;
        };
        qfprom@a0000 {
            compatible = "qcom,ipq5018-qfprom", "qcom,qfprom";
            reg = <0xa0000 0x1000>;
            #address-cells = <0x1>;
            #size-cells = <0x1>;
            status = "okay";
            mode@249 {
                reg = <0x249 0x1>;
                bits = <0x0 0x3>;
                phandle = <0x13>;
            };
            base1@249 {
                reg = <0x249 0x2>;
                bits = <0x3 0x8>;
                phandle = <0x14>;
            };
            base2@24a {
                reg = <0x24a 0x2>;
                bits = <0x3 0x8>;
                phandle = <0x15>;
            };
            s0-p1@24b {
                reg = <0x24b 0x2>;
                bits = <0x2 0x6>;
                phandle = <0x16>;
            };
            s0-p2@24c {
                reg = <0x24c 0x1>;
                bits = <0x1 0x6>;
                phandle = <0x17>;
            };
            s1-p1@24c {
                reg = <0x24c 0x2>;
                bits = <0x7 0x6>;
                phandle = <0x18>;
            };
            s1-p2@24d {
                reg = <0x24d 0x2>;
                bits = <0x5 0x6>;
                phandle = <0x19>;
            };
            s2-p1@24e {
                reg = <0x24e 0x2>;
                bits = <0x3 0x6>;
                phandle = <0x1a>;
            };
            s2-p2@24f {
                reg = <0x24f 0x1>;
                bits = <0x1 0x6>;
                phandle = <0x1b>;
            };
            s3-p1@24f {
                reg = <0x24f 0x2>;
                bits = <0x7 0x6>;
                phandle = <0x1c>;
            };
            s3-p2@250 {
                reg = <0x250 0x2>;
                bits = <0x5 0x6>;
                phandle = <0x1d>;
            };
            s4-p1@251 {
                reg = <0x251 0x2>;
                bits = <0x3 0x6>;
                phandle = <0x1e>;
            };
            s4-p2@254 {
                reg = <0x254 0x1>;
                bits = <0x0 0x6>;
                phandle = <0x1f>;
            };
        };
        rng@e3000 {
            compatible = "qcom,prng-ee";
            reg = <0xe3000 0x1000>;
            clocks = <0x9 0x43>;
            clock-names = "core";
            status = "okay";
        };
        thermal-sensor@4a9000 {
            compatible = "qcom,ipq5018-tsens";
            reg = <0x4a9000 0x1000 0x4a8000 0x1000>;
            nvmem-cells = <0x13 0x14 0x15 0x16 0x17 0x18 0x19 0x1a 0x1b 0x1c 0x1d 0x1e 0x1f>;
            nvmem-cell-names = "mode", "base1", "base2", "s0_p1", "s0_p2", "s1_p1", "s1_p2", "s2_p1", "s2_p2", "s3_p1", "s3_p2", "s4_p1", "s4_p2";
            interrupts = <0x0 0xb8 0x1>;
            interrupt-names = "uplow";
            #qcom,sensors = <0x5>;
            #thermal-sensor-cells = <0x1>;
            phandle = <0x3c>;
        };
        dma-controller@704000 {
            compatible = "qcom,bam-v1.7.4", "qcom,bam-v1.7.0";
            reg = <0x704000 0x20000>;
            interrupts = <0x0 0xcf 0x4>;
            clocks = <0x9 0x1f>;
            clock-names = "bam_clk";
            #dma-cells = <0x1>;
            qcom,ee = <0x1>;
            qcom,controlled-remotely;
            status = "okay";
            phandle = <0x20>;
        };
        crypto@73a000 {
            compatible = "qcom,crypto-v5.1";
            reg = <0x73a000 0x6000>;
            clocks = <0x9 0x1f 0x9 0x20 0x9 0x21>;
            clock-names = "iface", "bus", "core";
            dmas = <0x20 0x2 0x20 0x3>;
            dma-names = "rx", "tx";
            status = "okay";
        };
        pinctrl@1000000 {
            compatible = "qcom,ipq5018-tlmm";
            reg = <0x1000000 0x300000>;
            interrupts = <0x0 0xd0 0x4>;
            gpio-controller;
            #gpio-cells = <0x2>;
            gpio-ranges = <0x21 0x0 0x0 0x2f>;
            interrupt-controller;
            #interrupt-cells = <0x2>;
            phandle = <0x21>;
            uart1-state {
                pins = "gpio31", "gpio32", "gpio33", "gpio34";
                function = "blsp1_uart1";
                drive-strength = <0x8>;
                bias-pull-down;
            };
            mdio-state {
                phandle = <0xb>;
                mdc-pins {
                    pins = "gpio36";
                    function = "mdc";
                    drive-strength = <0x8>;
                    bias-pull-up;
                };
                mdio-pins {
                    pins = "gpio37";
                    function = "mdio";
                    drive-strength = <0x8>;
                    bias-pull-up;
                };
            };
            button-state {
                pins = "gpio32", "gpio38";
                function = "gpio";
                drive-strength = <0x8>;
                bias-pull-up;
                phandle = <0x40>;
            };
            modem-ctl-state {
                pins = "gpio26", "gpio35";
                function = "gpio";
                drive-strength = <0x8>;
                bias-disable;
                phandle = <0x41>;
            };
            qpic-state {
                phandle = <0x2d>;
                clock-pins {
                    pins = "gpio9";
                    function = "qspi_clk";
                    drive-strength = <0x8>;
                    bias-disable;
                };
                cs-pins {
                    pins = "gpio8";
                    function = "qspi_cs";
                    drive-strength = <0x8>;
                    bias-disable;
                };
                data-pins {
                    pins = "gpio4", "gpio5", "gpio6", "gpio7";
                    function = "qspi_data";
                    drive-strength = <0x8>;
                    bias-disable;
                };
            };
            uart0-state {
                pins = "gpio20", "gpio21";
                function = "blsp0_uart0";
                drive-strength = <0x8>;
                bias-disable;
                phandle = <0x29>;
            };
            i2c-state {
                pins = "gpio33", "gpio34";
                function = "blsp2_i2c0";
                drive-strength = <0x8>;
                bias-disable;
                phandle = <0x2b>;
            };
        };
        clock-controller@1800000 {
            compatible = "qcom,gcc-ipq5018";
            reg = <0x1800000 0x80000>;
            clocks = <0x22 0x23 0x24 0x25 0x26 0x27 0x28 0x12 0x0 0x12 0x1>;
            #clock-cells = <0x1>;
            #reset-cells = <0x1>;
            phandle = <0x9>;
        };
        hwlock@1905000 {
            compatible = "qcom,tcsr-mutex";
            reg = <0x1905000 0x20000>;
            #hwlock-cells = <0x1>;
            phandle = <0x8>;
        };
        syscon@1937000 {
            compatible = "qcom,tcsr-ipq5018", "syscon";
            reg = <0x1937000 0x21000>;
            phandle = <0x7>;
        };
        pwm@1941010 {
            compatible = "qcom,ipq5018-pwm", "qcom,ipq6018-pwm";
            reg = <0x1941010 0x20>;
            clocks = <0x9 0x12>;
            assigned-clocks = <0x9 0x12>;
            assigned-clock-rates = <0x5f5e100>;
            #pwm-cells = <0x3>;
            status = "disabled";
        };
        mmc@7804000 {
            compatible = "qcom,ipq5018-sdhci", "qcom,sdhci-msm-v5";
            reg = <0x7804000 0x1000>;
            reg-names = "hc";
            interrupts = <0x0 0x7b 0x4 0x0 0x8a 0x4>;
            interrupt-names = "hc_irq", "pwr_irq";
            clocks = <0x9 0x59 0x9 0x5a 0x22>;
            clock-names = "iface", "core", "xo";
            non-removable;
            status = "disabled";
        };
        dma-controller@7884000 {
            compatible = "qcom,bam-v1.7.0";
            reg = <0x7884000 0x1d000>;
            interrupts = <0x0 0xee 0x4>;
            clocks = <0x9 0x13>;
            clock-names = "bam_clk";
            #dma-cells = <0x1>;
            qcom,ee = <0x0>;
            phandle = <0x2a>;
        };
        serial@78af000 {
            compatible = "qcom,msm-uartdm-v1.4", "qcom,msm-uartdm";
            reg = <0x78af000 0x200>;
            interrupts = <0x0 0x6b 0x4>;
            clocks = <0x9 0x1a 0x9 0x13>;
            clock-names = "core", "iface";
            status = "okay";
            pinctrl-0 = <0x29>;
            pinctrl-names = "default";
        };
        serial@78b0000 {
            compatible = "qcom,msm-uartdm-v1.4", "qcom,msm-uartdm";
            reg = <0x78b0000 0x200>;
            interrupts = <0x0 0x6c 0x4>;
            clocks = <0x9 0x1b 0x9 0x13>;
            clock-names = "core", "iface";
            status = "disabled";
        };
        spi@78b5000 {
            compatible = "qcom,spi-qup-v2.2.1";
            #address-cells = <0x1>;
            #size-cells = <0x0>;
            reg = <0x78b5000 0x600>;
            interrupts = <0x0 0x5f 0x4>;
            clocks = <0x9 0x15 0x9 0x13>;
            clock-names = "core", "iface";
            dmas = <0x2a 0x4 0x2a 0x5>;
            dma-names = "tx", "rx";
            status = "disabled";
        };
        i2c@78b7000 {
            compatible = "qcom,i2c-qup-v2.2.1";
            reg = <0x78b7000 0x600>;
            #address-cells = <0x1>;
            #size-cells = <0x0>;
            interrupts = <0x0 0x61 0x4>;
            clocks = <0x9 0x18 0x9 0x13>;
            clock-names = "core", "iface";
            clock-frequency = <0x61a80>;
            dmas = <0x2a 0x9 0x2a 0x8>;
            dma-names = "tx", "rx";
            status = "okay";
            pinctrl-0 = <0x2b>;
            pinctrl-names = "default";
        };
        dma-controller@7984000 {
            compatible = "qcom,bam-v1.7.4", "qcom,bam-v1.7.0";
            reg = <0x7984000 0x1c000>;
            interrupts = <0x0 0x92 0x4>;
            clocks = <0x9 0x56>;
            clock-names = "bam_clk";
            #dma-cells = <0x1>;
            qcom,ee = <0x0>;
            status = "okay";
            phandle = <0x2c>;
        };
        spi@79b0000 {
            compatible = "qcom,ipq5018-snand", "qcom,ipq9574-snand";
            reg = <0x79b0000 0x10000>;
            #address-cells = <0x1>;
            #size-cells = <0x0>;
            clocks = <0x9 0x57 0x9 0x56 0x9 0x58>;
            clock-names = "core", "aon", "iom";
            dmas = <0x2c 0x0 0x2c 0x1 0x2c 0x2>;
            dma-names = "tx", "rx", "cmd";
            status = "okay";
            pinctrl-0 = <0x2d>;
            pinctrl-names = "default";
            phandle = <0x2e>;
            nand@0 {
                compatible = "spi-nand";
                reg = <0x0>;
                nand-ecc-engine = <0x2e>;
                nand-ecc-strength = <0x4>;
                nand-ecc-step-size = <0x200>;
                nand-bus-width = <0x8>;
                partitions {
                    compatible = "fixed-partitions";
                    #address-cells = <0x1>;
                    #size-cells = <0x1>;
                    partition@0 {
                        label = "0:sbl1";
                        reg = <0x0 0x80000>;
                        read-only;
                    };
                    partition@80000 {
                        label = "0:mibib";
                        reg = <0x80000 0x80000>;
                        read-only;
                    };
                    partition@100000 {
                        label = "0:bootconfig";
                        reg = <0x100000 0x40000>;
                        read-only;
                    };
                    partition@140000 {
                        label = "0:bootconfig1";
                        reg = <0x140000 0x40000>;
                        read-only;
